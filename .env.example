# Copy this file to .env.local and fill in your own values. .env.local is gitignored — never commit it.

# Where data is stored: json (default, files in data/) or supabase (ot_ tables). Restart the dev server after changing.
OT_STORAGE=json

# Your salary history (SECRET, server only, never sent to the browser). One row per salary change;
# the row valid on each OT date is used. Base hourly = amount ÷ 240 (30 days × 8 h).
SALARY_HISTORY=[{"from":"2030-01-01","amount":1000000}]

# Only needed when OT_STORAGE=supabase. Service role key = server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
